datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String
  name               String?
  emailAnniversaries Boolean  @default(false)
  emailNameDays      Boolean  @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  trees              Tree[]
  resetTokens        PasswordResetToken[]
  familySearchConnection FamilySearchConnection?
}

model Tree {
  id           String   @id @default(uuid())
  name         String
  description  String?
  userPersonId String?
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  people       Person[]
  unions       Union[]
  media        Media[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Person {
  id             String    @id @default(uuid())
  firstName      String
  lastName       String
  birthName      String?
  gender         String    // "M" = Male, "F" = Female, "U" = Unknown
  birthDate      String?
  birthPlace     String?
  baptismDate    String?
  baptismPlace   String?
  deathDate      String?
  deathPlace     String?
  burialDate     String?
  burialPlace    String?
  occupation     String?
  notes          String?
  avatarUrl      String?
  sources        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Multi-tree scope
  treeId         String?
  tree           Tree?     @relation(fields: [treeId], references: [id], onDelete: Cascade)

  // Self-referential parenting relationships
  fatherId       String?
  motherId       String?
  father         Person?   @relation("FatherOf", fields: [fatherId], references: [id], onDelete: SetNull)
  mother         Person?   @relation("MotherOf", fields: [motherId], references: [id], onDelete: SetNull)
  
  fatherOf       Person[]  @relation("FatherOf")
  motherOf       Person[]  @relation("MotherOf")

  // Unions/Marriages
  unionsPartner1 Union[]   @relation("Partner1")
  unionsPartner2 Union[]   @relation("Partner2")

  // Documents and photos
  media          Media[]
}

model Union {
  id           String   @id @default(uuid())
  partner1Id   String
  partner2Id   String
  type         String   // "MARRIAGE", "PARTNERSHIP", "OTHER"
  weddingDate  String?
  weddingPlace String?
  divorceDate  String?
  isDivorced   Boolean  @default(false)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Multi-tree scope
  treeId       String?
  tree         Tree?    @relation(fields: [treeId], references: [id], onDelete: Cascade)

  partner1     Person   @relation("Partner1", fields: [partner1Id], references: [id], onDelete: Cascade)
  partner2     Person   @relation("Partner2", fields: [partner2Id], references: [id], onDelete: Cascade)
}

model Media {
  id          String   @id @default(uuid())
  personId    String
  url         String   // Path or URL to the file
  title       String
  type        String   // "PHOTO", "DOCUMENT", "OTHER"
  date        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Multi-tree scope
  treeId      String?
  tree        Tree?    @relation(fields: [treeId], references: [id], onDelete: Cascade)

  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model FeatureRequest {
  id          String   @id @default(uuid())
  title       String
  description String
  category    String   @default("other") // "ui", "performance", "import-export", "familysearch", "other"
  status      String   @default("PENDING") // "PENDING", "PLANNED", "COMPLETED", "REJECTED"
  userEmail   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model FamilySearchConnection {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken   String
  expiresAt     DateTime
  fsUserId      String
  fsUsername    String
  fsContactName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

